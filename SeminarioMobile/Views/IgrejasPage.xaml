<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="RaizPagina"
    x:Class="SeminarioMobile.Views.IgrejasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SeminarioMobile.ViewModels"
    xmlns:models="clr-namespace:SeminarioMobile.Models"
    x:DataType="vm:IgrejasViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView x:Name="ScrollPrincipal">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Border Style="{StaticResource HeaderCardStyle}" Background="{StaticResource GradienteIgrejas}">
                    <HorizontalStackLayout Spacing="14">
                        <Button Style="{StaticResource MenuButtonStyle}" Clicked="OnMenuClicked" />
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="6" HeightRequest="46" WidthRequest="46">
                            <Image Source="icone_igreja.svg" WidthRequest="34" HeightRequest="34" Aspect="AspectFit" />
                        </Border>
                        <Label Text="Igrejas" Style="{StaticResource HeaderTitleStyle}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Label Text="O local marcado como ativo é o que aparece no rodapé do banner." FontSize="12" TextColor="{AppThemeBinding Light=#64748b, Dark=#CBD5E1}" />

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding TituloFormulario}" FontSize="16" FontAttributes="Bold" TextColor="#F59E0B" />
                        <Label Text="Texto do rodapé" FontSize="13" TextColor="#64748b" />
                        <Entry Text="{Binding Nome}" Placeholder="ICM HINTERLAND" MaxLength="80" TextColor="#1e293b" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Salvar" Command="{Binding SalvarCommand}" BackgroundColor="#F59E0B" TextColor="White" CornerRadius="12" />
                            <Button Text="Cancelar edição" Command="{Binding CancelarEdicaoCommand}" IsVisible="{Binding EmEdicao}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Igrejas" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}" />

                <CollectionView ItemsSource="{Binding Itens}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24" Spacing="6" HorizontalOptions="Center">
                            <Label Text="⛪" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Nenhuma igreja cadastrada ainda" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#475569, Dark=#E2E8F0}" HorizontalOptions="Center" />
                            <Label Text="Digite o texto do rodapé acima e toque em Salvar." FontSize="12" TextColor="{AppThemeBinding Light=#94a3b8, Dark=#CBD5E1}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Igreja">
                            <Border Style="{StaticResource ItemCardStyle}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Image Source="icone_igreja.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Nome}" VerticalOptions="Center" TextColor="#1e293b" FontAttributes="Bold" Margin="10,0" />
                                        <Label Grid.Column="2" Text="{Binding Ativo, Converter={StaticResource AtivoParaTextoConverter}}"
                                               TextColor="{Binding Ativo, Converter={StaticResource AtivoParaCorConverter}}"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Usar no banner" Style="{StaticResource AtivarButtonStyle}"
                                                IsVisible="{Binding Ativo, Converter={StaticResource InversorBoolConverter}}"
                                                Command="{Binding Source={x:Reference RaizPagina}, Path=BindingContext.AtivarCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Editar" Style="{StaticResource EditButtonStyle}"
                                                Command="{Binding Source={x:Reference RaizPagina}, Path=BindingContext.EditarCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Excluir" Style="{StaticResource DeleteButtonStyle}"
                                                Command="{Binding Source={x:Reference RaizPagina}, Path=BindingContext.ExcluirCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <Button Text="↑" Style="{StaticResource FabStyle}" BackgroundColor="#F59E0B" Clicked="OnFabClicked" />    </Grid>
</ContentPage>
